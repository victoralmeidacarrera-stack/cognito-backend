{{! Base de todo template novo: fontes, tokens de marca, reset e utilitários. }}
{{! Vai DENTRO de <style>. Cada template escreve só a própria composição.    }}
{{{layout.fontsImport}}}
:root {
  --primary: {{brand.primaryColor}};
  --secondary: {{brand.secondaryColor}};
  --accent: {{brand.accentColor}};
  --on-primary: {{brand.onPrimary}};
  --on-secondary: {{brand.onSecondary}};
  --on-accent: {{brand.onAccent}};
  --text: {{layout.textColor}};
  --head: '{{layout.headlineFont}}', 'Syne', system-ui, sans-serif;
  --body: '{{layout.bodyFont}}', system-ui, sans-serif;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: {{canvas.width}}px; height: {{canvas.height}}px; }
body {
  font-family: var(--body);
  background: var(--primary);
  color: var(--on-primary);
  position: relative;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}
img { display: block; }
.bleed { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.head { font-family: var(--head); font-weight: 800; line-height: 1.02; letter-spacing: -0.02em; }
.legal { font-family: var(--body); font-size: 19px; line-height: 1.3; opacity: 0.66; }
.eyebrow {
  font-family: var(--body);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
}
