<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <style>
      {{> base-style}}

      body { padding: 140px 56px 120px; display: flex; flex-direction: column; }
      .window {
        position: relative; width: 100%; height: 700px;
        border-radius: 32px; overflow: hidden; background: var(--secondary); flex-shrink: 0;
      }
      .window::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.35), transparent 55%);
      }
      .store-name { position: absolute; top: 30px; left: 34px; z-index: 3; font-size: 22px; color: #fff; }
      .store-logo { position: absolute; top: 26px; left: 34px; z-index: 3; height: 58px; object-fit: contain; }

      .headline { font-size: 60px; margin-top: 48px; max-width: 94%; }

      .offer-label { font-size: 24px; opacity: 0.62; margin-top: 44px; }
      .offer-value {
        font-family: var(--head); font-weight: 800; line-height: 0.92;
        font-size: 156px; color: var(--accent); margin-top: 10px; letter-spacing: -0.03em;
      }
      .side { display: flex; gap: 48px; margin-top: 30px; }
      .side-label { font-size: 19px; opacity: 0.55; letter-spacing: 0.14em; text-transform: uppercase; }
      .side-value { font-size: 38px; font-weight: 700; margin-top: 4px; }

      .price-line { margin-top: 28px; font-size: 28px; opacity: 0.78; }
      .price-line strong { font-weight: 700; opacity: 1; }

      .spacer { flex: 1; }
      .cta {
        background: var(--accent); color: var(--on-accent);
        padding: 32px; border-radius: 20px; text-align: center;
        font-size: {{layout.ctaSize}}px; font-weight: 700;
      }
      .legal { margin-top: 24px; }
    </style>
  </head>
  <body>
    <div class="window">
      {{#if photoUrl}}<img class="bleed" src="{{photoUrl}}" alt="" />{{/if}}
      {{> store-tag}}
    </div>

    <h1 class="head headline">{{headline}}</h1>

    {{#if offer.parcela}}
      <div class="offer-label">Parcelas a partir de</div>
      <div class="offer-value">{{offer.parcela}}</div>
      {{! Entrada e taxa são independentes — ver o comentário no feed. }}
      {{#if offer.entrada}}
        <div class="side">
          <div>
            <div class="side-label">Entrada</div>
            <div class="side-value">{{offer.entrada}}</div>
          </div>
          {{#if offer.taxa}}
            <div>
              <div class="side-label">Taxa</div>
              <div class="side-value">{{offer.taxa}}</div>
            </div>
          {{/if}}
        </div>
      {{else if offer.taxa}}
        <div class="side">
          <div>
            <div class="side-label">Taxa</div>
            <div class="side-value">{{offer.taxa}}</div>
          </div>
        </div>
      {{/if}}
      {{#if price}}<div class="price-line">Valor à vista: <strong>{{price}}</strong></div>{{/if}}
    {{else if price}}
      <div class="offer-label">Por</div>
      <div class="offer-value">{{price}}</div>
    {{/if}}

    <div class="spacer"></div>
    <div class="cta">{{cta}}</div>
    {{> legal}}
  </body>
</html>
