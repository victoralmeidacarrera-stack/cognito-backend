<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <style>
      {{> base-style}}

      /* Reserva a faixa do rodapé (ver comentário na versão de feed). */
      body {
        display: flex; align-items: center; justify-content: center;
        padding: 300px 0 460px;
        background:
          radial-gradient(120% 70% at 50% 10%, rgba(255,255,255,0.10), transparent 60%),
          var(--primary);
      }
      .ribbon {
        position: absolute; top: 200px; left: 0; right: 0; text-align: center;
        font-size: 24px; letter-spacing: 0.3em; text-transform: uppercase;
        font-weight: 700; color: var(--accent);
      }

      .polaroid {
        width: 880px; background: #fff; color: #111;
        padding: 32px 32px 44px; border-radius: 6px;
        box-shadow: 0 44px 100px rgba(0,0,0,0.5);
        transform: rotate(-1.6deg);
      }
      .shot { position: relative; width: 100%; height: 800px; background: #dcdce4; overflow: hidden; border-radius: 2px; }
      .caption { margin-top: 34px; text-align: center; }
      .congrats { font-family: var(--head); font-size: 64px; font-weight: 800; line-height: 1.02; letter-spacing: -0.02em; }
      .model { font-size: 32px; margin-top: 16px; color: #444; }

      .footer {
        position: absolute; left: 0; right: 0; bottom: 190px;
        display: flex; flex-direction: column; align-items: center; gap: 20px;
        padding: 0 72px; text-align: center;
      }
      .cta { border: 2px solid var(--accent); color: var(--accent); padding: 22px 42px; border-radius: 999px; font-size: 32px; font-weight: 700; }
      .store-name { font-size: 22px; opacity: 0.75; }
      .store-logo { height: 50px; object-fit: contain; }
      .legal { text-align: center; max-width: 84%; }
    </style>
  </head>
  <body>
    <div class="ribbon">Entrega realizada</div>

    <div class="polaroid">
      <div class="shot">
        {{#if photoUrl}}<img class="bleed" src="{{photoUrl}}" alt="" />{{/if}}
      </div>
      <div class="caption">
        <div class="congrats">{{headline}}</div>
        {{#if vehicle.nome}}
          <div class="model">{{vehicle.nome}}{{#if vehicle.anoLabel}} · {{vehicle.anoLabel}}{{/if}}</div>
        {{else if sub_headline}}
          <div class="model">{{sub_headline}}</div>
        {{/if}}
      </div>
    </div>

    <div class="footer">
      <span class="cta">{{cta}}</span>
      {{> store-tag}}
      {{> legal}}
    </div>
  </body>
</html>
