<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <style>
      {{> base-style}}

      /* Split vertical: foto à esquerda, argumento à direita. Peça de conversão
         (agendamento), por isso os diferenciais viram lista e o CTA domina. */
      body { display: flex; }

      .col-photo { position: relative; width: 440px; flex-shrink: 0; background: var(--secondary); }
      .col-photo::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to right, transparent 60%, rgba(0,0,0,0.25));
      }

      /* Conteúdo centrado na coluna: com `flex:1` num spacer sobrava um buraco
         vertical entre a lista e o preço. */
      .col-text { flex: 1; min-width: 0; padding: 64px 60px; display: flex; flex-direction: column; justify-content: center; }
      .eyebrow-line { font-size: 20px; color: var(--accent); }
      .headline { font-size: 62px; margin-top: 20px; line-height: 1.02; }
      .sub { font-size: 26px; line-height: 1.4; opacity: 0.8; margin-top: 20px; }

      .list { margin-top: 34px; display: flex; flex-direction: column; gap: 16px; }
      .item { display: flex; align-items: flex-start; gap: 14px; font-size: 25px; line-height: 1.25; }
      .item::before {
        content: ''; flex-shrink: 0; margin-top: 9px;
        width: 12px; height: 12px; border-radius: 3px; background: var(--accent);
      }

      .price-label { font-size: 17px; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.55; margin-top: 40px; }
      .price { font-family: var(--head); font-size: 50px; font-weight: 800; color: var(--accent); line-height: 1; margin-top: 6px; }
      .cta {
        margin-top: 26px;
        background: var(--accent); color: var(--on-accent);
        padding: 22px 30px; border-radius: 14px;
        font-size: 30px; font-weight: 700;
        display: flex; align-items: center; justify-content: space-between; gap: 14px;
      }
      .cta .arrow { font-size: 34px; line-height: 1; }
      .store-name { font-size: 18px; opacity: 0.65; margin-top: 22px; }
      .store-logo { height: 40px; object-fit: contain; margin-top: 22px; }
      .legal { margin-top: 16px; font-size: 16px; }
    </style>
  </head>
  <body>
    <div class="col-photo">
      {{#if photoUrl}}<img class="bleed" src="{{photoUrl}}" alt="" />{{/if}}
    </div>

    <div class="col-text">
      {{#if vehicle.nome}}<div class="eyebrow-line eyebrow">{{vehicle.nome}}</div>{{/if}}
      <h1 class="head headline">{{headline}}</h1>
      {{#if sub_headline}}<div class="sub">{{sub_headline}}</div>{{/if}}

      {{#if vehicle.highlights.length}}
        <div class="list">
          {{#each vehicle.highlights}}<div class="item">{{this}}</div>{{/each}}
        </div>
      {{/if}}

      {{#if price}}
        <div class="price-label">A partir de</div>
        <div class="price">{{price}}</div>
      {{/if}}

      <div class="cta"><span>{{cta}}</span><span class="arrow">→</span></div>
      {{> store-tag}}
      {{> legal}}
    </div>
  </body>
</html>
