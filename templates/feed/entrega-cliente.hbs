<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <style>
      {{> base-style}}

      /* Moldura tipo polaroid sobre fundo da marca. Peça de relacionamento:
         sem preço, sem urgência — o protagonista é a foto do cliente. */
      /* padding-bottom reserva a faixa do rodapé: sem isso a polaroid,
         centralizada, cobre o CTA. */
      body {
        display: flex; align-items: center; justify-content: center;
        padding: 130px 0 330px;
        background:
          radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,0.10), transparent 60%),
          var(--primary);
      }
      .ribbon {
        position: absolute; top: 60px; left: 0; right: 0; text-align: center;
        font-size: 22px; letter-spacing: 0.3em; text-transform: uppercase;
        font-weight: 700; color: var(--accent);
      }

      .polaroid {
        width: 790px; background: #fff; color: #111;
        padding: 26px 26px 34px; border-radius: 6px;
        box-shadow: 0 40px 90px rgba(0,0,0,0.45);
        transform: rotate(-1.6deg);
      }
      .shot {
        position: relative; width: 100%; height: 560px;
        background: #dcdce4; overflow: hidden; border-radius: 2px;
      }
      .caption { margin-top: 26px; text-align: center; }
      .congrats {
        font-family: var(--head); font-size: 48px; font-weight: 800;
        line-height: 1.04; letter-spacing: -0.02em;
      }
      .model { font-size: 27px; margin-top: 12px; color: #444; }

      .footer {
        position: absolute; left: 0; right: 0; bottom: 58px;
        display: flex; flex-direction: column; align-items: center; gap: 18px;
        padding: 0 72px; text-align: center;
      }
      .cta {
        border: 2px solid var(--accent); color: var(--accent);
        padding: 18px 38px; border-radius: 999px;
        font-size: 30px; font-weight: 700;
      }
      .store-name { font-size: 20px; opacity: 0.75; }
      .store-logo { height: 46px; object-fit: contain; }
      .legal { text-align: center; max-width: 80%; }
    </style>
  </head>
  <body>
    <div class="ribbon">Entrega realizada</div>

    <div class="polaroid">
      <div class="shot">
        {{#if photoUrl}}<img class="bleed" src="{{photoUrl}}" alt="" />{{/if}}
      </div>
      <div class="caption">
        <div class="congrats">{{headline}}</div>
        {{#if vehicle.nome}}
          <div class="model">{{vehicle.nome}}{{#if vehicle.anoLabel}} · {{vehicle.anoLabel}}{{/if}}</div>
        {{else if sub_headline}}
          <div class="model">{{sub_headline}}</div>
        {{/if}}
      </div>
    </div>

    <div class="footer">
      <span class="cta">{{cta}}</span>
      {{> store-tag}}
      {{> legal}}
    </div>
  </body>
</html>
