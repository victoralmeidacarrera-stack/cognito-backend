<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <style>
      {{> base-style}}

      /* Moldura da marca + tag rotacionada. Foto "encaixada", não sangrada —
         lê como anúncio de novidade, não como oferta. */
      body { padding: 26px; background: var(--accent); }
      .frame {
        position: relative; width: 100%; height: 100%;
        background: var(--primary); color: var(--on-primary);
        border-radius: 20px; overflow: hidden;
        display: flex; flex-direction: column;
      }
      .photo-box { position: relative; height: 700px; flex-shrink: 0; background: var(--secondary); }
      .photo-box::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent 50%);
      }

      .tag {
        position: absolute; top: 52px; left: -8px; z-index: 4;
        transform: rotate(-6deg);
        background: var(--accent); color: var(--on-accent);
        padding: 16px 34px;
        font-family: var(--head); font-size: 40px; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.06em;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
      }
      .store-name { position: absolute; top: 60px; right: 44px; z-index: 4; font-size: 20px; color: #fff; }
      .store-logo { position: absolute; top: 48px; right: 44px; z-index: 4; height: 54px; object-fit: contain; }

      .body-area { flex: 1; padding: 46px 56px 44px; display: flex; flex-direction: column; }
      .model { font-family: var(--head); font-size: 76px; font-weight: 800; line-height: 0.98; letter-spacing: -0.025em; }
      .year { font-size: 24px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.6; margin-top: 10px; }
      .headline { font-size: 38px; font-weight: 600; line-height: 1.15; margin-top: 22px; opacity: 0.95; max-width: 94%; }

      .spacer { flex: 1; }
      /* flex-wrap + min-width:0: preço e CTA são textos longos e variáveis;
         sem isso o min-content de cada um empurra o outro para fora da peça. */
      .foot {
        display: flex; align-items: center; justify-content: space-between;
        gap: 20px; flex-wrap: wrap;
      }
      .price { font-family: var(--head); font-size: 48px; font-weight: 800; color: var(--accent); line-height: 1; min-width: 0; }
      .cta {
        background: var(--accent); color: var(--on-accent);
        padding: 20px 34px; border-radius: 12px;
        font-size: 30px; font-weight: 700; white-space: nowrap;
      }
      .legal { margin-top: 20px; }
    </style>
  </head>
  <body>
    <div class="frame">
      <div class="photo-box">
        {{#if photoUrl}}<img class="bleed" src="{{photoUrl}}" alt="" />{{/if}}
        <span class="tag">Chegou</span>
        {{> store-tag}}
      </div>

      <div class="body-area">
        {{#if vehicle.nome}}
          <div class="model">{{vehicle.nome}}</div>
          {{#if vehicle.anoLabel}}<div class="year">{{vehicle.anoLabel}}{{#if vehicle.color}} · {{vehicle.color}}{{/if}}</div>{{/if}}
          <div class="headline">{{headline}}</div>
        {{else}}
          <div class="model">{{headline}}</div>
          {{#if sub_headline}}<div class="headline">{{sub_headline}}</div>{{/if}}
        {{/if}}

        <div class="spacer"></div>
        <div class="foot">
          {{#if price}}<div class="price">{{price}}</div>{{else}}<div></div>{{/if}}
          <span class="cta">{{cta}}</span>
        </div>
        {{> legal}}
      </div>
    </div>
  </body>
</html>
