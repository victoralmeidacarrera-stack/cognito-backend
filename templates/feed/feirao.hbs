<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <style>
      {{> base-style}}

      /* Campanha: faixa de urgência no topo, foto em tela cheia sob overlay
         forte e headline em caixa alta. Peça feita para ser lida em 1 segundo. */
      .bleed { filter: saturate(1.05); }
      .scrim {
        position: absolute; inset: 0;
        background:
          linear-gradient(to top, var(--primary) 4%, rgba(0,0,0,0.55) 45%, rgba(0,0,0,0.25) 100%);
      }

      .strip {
        position: absolute; top: 0; left: 0; right: 0; height: 96px;
        background: var(--accent); color: var(--on-accent);
        display: flex; align-items: center; justify-content: center; gap: 22px;
        font-size: 28px; font-weight: 800;
        text-transform: uppercase; letter-spacing: 0.22em;
        overflow: hidden; white-space: nowrap;
      }
      .strip span { opacity: 0.35; }
      .strip .lead { opacity: 1; letter-spacing: 0.26em; }

      .store-name { position: absolute; top: 132px; left: 64px; font-size: 21px; opacity: 0.9; }
      .store-logo { position: absolute; top: 122px; left: 64px; height: 56px; object-fit: contain; }

      .datebox {
        position: absolute; top: 128px; right: 64px;
        border: 3px solid var(--accent); border-radius: 18px;
        padding: 16px 24px; text-align: center; background: rgba(0,0,0,0.35);
      }
      .datebox .k { font-size: 15px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.75; }
      .datebox .v { font-family: var(--head); font-size: 34px; font-weight: 800; margin-top: 4px; line-height: 1; }

      .content {
        position: absolute; left: 0; right: 0; bottom: 0;
        padding: 0 72px 64px;
      }
      .headline {
        font-size: {{layout.headlineSize}}px;
        text-transform: uppercase; letter-spacing: -0.015em; line-height: 0.96;
        max-width: 96%;
      }
      .sub { font-size: {{layout.bodySize}}px; margin-top: 18px; opacity: 0.9; max-width: 86%; }
      .foot {
        display: flex; align-items: center; justify-content: space-between;
        gap: 20px; margin-top: 34px; flex-wrap: wrap;
      }
      .price { font-family: var(--head); font-size: 54px; font-weight: 800; color: var(--accent); line-height: 1; min-width: 0; }
      .cta {
        background: #fff; color: #111;
        padding: 22px 38px; border-radius: 999px;
        font-size: 32px; font-weight: 800; white-space: nowrap;
      }
      .legal { margin-top: 24px; }
    </style>
  </head>
  <body>
    {{#if photoUrl}}<img class="bleed" src="{{photoUrl}}" alt="" />{{/if}}
    <div class="scrim"></div>

    <div class="strip">
      <span>{{#if offer.selo}}{{offer.selo}}{{else}}Feirão{{/if}}</span>
      <span class="lead">{{#if offer.selo}}{{offer.selo}}{{else}}Feirão{{/if}}</span>
      <span>{{#if offer.selo}}{{offer.selo}}{{else}}Feirão{{/if}}</span>
    </div>

    {{> store-tag}}

    {{#if offer.periodo}}
      <div class="datebox"><div class="k">Quando</div><div class="v">{{offer.periodo}}</div></div>
    {{else if offer.validade}}
      <div class="datebox"><div class="k">Até</div><div class="v">{{offer.validade}}</div></div>
    {{/if}}

    <div class="content">
      <h1 class="head headline">{{headline}}</h1>
      {{#if sub_headline}}<div class="sub">{{sub_headline}}</div>{{/if}}
      <div class="foot">
        {{#if price}}<div class="price">{{price}}</div>{{else}}<div></div>{{/if}}
        <span class="cta">{{cta}}</span>
      </div>
      {{> legal}}
    </div>
  </body>
</html>
