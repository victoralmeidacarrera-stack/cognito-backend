# ──────────────────────────────────────────────
# Cognito AI backend — variáveis de ambiente
# Copie para .env e preencha. Validado por zod em src/config/env.ts
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug
# Logs formatados p/ humano (pino-pretty). É devDependency: NÃO ligue em produção
# (o runner roda --omit=dev e o boot quebra). Vazio = liga só fora de produção.
LOG_PRETTY=true

# CORS: origens permitidas separadas por vírgula (ex.: https://app.cognito.ai).
# Vazio em dev = reflete a origem da requisição.
CORS_ORIGINS=

# Database (Postgres local via docker-compose / Neon em prod)
DATABASE_URL=postgresql://cognito:cognito@localhost:5432/cognito?schema=public

# Redis (BullMQ) — local via docker-compose / Upstash em prod
REDIS_URL=redis://localhost:6379

# ── IA de copy ─────────────────────────────────
# Provedor: 'fal' (default) · 'anthropic' (fallback) · 'openai' (qualquer API
# compatível com OpenAI chat/completions: OpenAI, DeepSeek, Groq, Ollama...).
# 'fal' usa o endpoint fal-ai/any-llm com a MESMA FAL_API_KEY do Flux — todo o
# custo de IA fica num fornecedor só (config das vars fal mais abaixo).
COPY_PROVIDER=fal

# Só para COPY_PROVIDER=openai (exemplos: https://api.deepseek.com/v1 +
# deepseek-chat · https://api.groq.com/openai/v1 + llama-3.3-70b-versatile ·
# http://localhost:11434/v1 + llama3 no Ollama, sem LLM_API_KEY):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Para COPY_PROVIDER=anthropic (fallback, com prompt caching no BrandBook).
# Também é usada, com QUALQUER provedor, se FAL_API_KEY estiver vazia e você
# chamar a análise de referência de layout (o caminho de visão cai no Claude).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL_BRIEFING=claude-sonnet-4-5
ANTHROPIC_MODEL_VARIATIONS=claude-haiku-4-5-20251001

# ── fal.ai (copy + imagem) ─────────────────────
# A mesma chave serve para o Flux (fundo dos criativos) e para o any-llm (copy).
FAL_API_KEY=

# Modelos do fal-ai/any-llm. Os "standard" (gemini-2.5-flash, gemini-2.5-flash-lite,
# llama, gpt-4o-mini...) são a faixa barata; os "premium" (anthropic/claude-sonnet-4.5,
# openai/gpt-5-chat, gemini-2.5-pro...) custam ~10x. Default: standard.
FAL_LLM_MODEL=google/gemini-2.5-flash
FAL_VISION_MODEL=google/gemini-2.5-flash

# O any-llm cobra POR REQUEST e NÃO devolve contagem de tokens — logo o custo
# não é calculável. Este é o valor fixo por chamada, em micro-centavos de USD
# (1 microcent = 1e-8 USD), só para telemetria. 0 = "custo desconhecido"
# (NÃO significa grátis): pegue o valor real no dashboard do fal e preencha.
FAL_LLM_COST_MICROCENTS=0

# Flux 1.1 Pro (fundo dos criativos). O prompt do fundo é montado em
# src/modules/backgrounds/background-prompt.ts e pode ser sobrescrito aqui
# ({vehicle} é substituído pela descrição do veículo):
FLUX_BACKGROUND_PROMPT=

# Composição foto real + cenário (default ligado): recorta o carro da foto do
# banco (remoção de fundo) e cola sobre uma cena vazia do Flux. 'false' volta
# a usar a foto crua como fundo. FLUX_SCENE_PROMPT muda a cena (sem carro!).
VEHICLE_COMPOSITE=true
FLUX_SCENE_PROMPT=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cognito-creatives
R2_PUBLIC_URL=https://cdn.example.com

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=Cognito AI <no-reply@cognito.ai>

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Auth: bypass do Clerk em dev (resolve a org/admin demo ou os headers
# x-dev-user-id / x-dev-org-id). Forçado off em produção. Default: true em dev.
AUTH_DEV_BYPASS=true

# Puppeteer: caminho do Chromium em prod (Railway). Vazio = bundled.
PUPPETEER_EXECUTABLE_PATH=

# Sentry (observabilidade) — opcional em dev
SENTRY_DSN=
